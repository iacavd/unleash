cmd_harden() {
	if ! is_root; then
		error_exit "ERROR E_NOT_ROOT: harden needs root. Live-OS cleanup cannot run without sudo. Next: sudo ./unleash harden"
	fi
	harden_live_os
	# result_fail returns 0; map CLI fail to process exit 1. Skip stays 0.
	case "${RESULT_STATUS:-ok}" in
		fail) exit 1 ;;
	esac
}

cmd_audit() {
	# audit is status (never kill). || so exit 3 is not an ERR trap.
	cmd_status "$@" || exit $?
}

cmd_whitelist() {
	cmd_firewall "$@"
}

cmd_status() {
	local data_mount=""
	if [ -n "${UNLEASH_VOLUME:-}" ]; then
		DATA_ROOT="$UNLEASH_VOLUME"
		data_mount="$UNLEASH_VOLUME"
	elif is_recovery; then
		data_mount=$(resolve_data_volume) || exit 2
		DATA_ROOT="$data_mount"
	else
		DATA_ROOT=""
		data_mount=""
	fi
	# || so a dirty exit 3 is not an ERR-trap "unhandled error".
	run_status || exit $?
}

cmd_check() {
  if ! is_root; then
    error_exit "ERROR E_NOT_ROOT: check needs root. Pre-format probes need sudo. Next: sudo ./unleash check"
  fi
  run_preformat_check
  echo ""
  check_upgrade_safety
}

cmd_monitor() {
  # main re-feeds $1=monitor; dispatch on $2 / remaining positionals.
  local sub=""
  while [ $# -gt 0 ]; do
    case "$1" in
      monitor|mn) shift ;;
      install) sub=install; shift ;;
      uninstall) sub=uninstall; shift ;;
      --webhook)
        DISCORD_WEBHOOK="${2:-}"
        shift 2
        ;;
      *) shift ;;
    esac
  done
  case "$sub" in
    install) cmd_persist ;;
    uninstall) cmd_unpersist ;;
    *)
      # Bare monitor must not start the old KeepAlive loop.
      if is_persist_installed; then
        info "Persist heal daemon is installed (monitor is an alias of persist)."
      else
        error_exit "ERROR: monitor is an alias of persist. Next: sudo ./unleash persist"
      fi
      ;;
  esac
}

cmd_monitor_stop() { stop_monitor; }
cmd_monitor_status() { monitor_status; }
cmd_doctor() {
	if [ "${UNLEASH_GATE:-0}" = 1 ]; then
		if run_doctor --gate; then
			return 0
		fi
		if [ "${UNLEASH_JSON:-0}" = 1 ]; then
			emit_json 2 "${PIPELINE_NEXT:-fix preflight}" "${UNLEASH_VOLUME:-}"
		fi
		exit 2
	fi
	run_doctor
}

cmd_interactive_recovery() {
	header "unleash — macOS Recovery Mode"

	local data_mount
	data_mount=$(resolve_data_volume)
	is_recovery && DATA_ROOT="$data_mount" || DATA_ROOT=""
	echo ""

	local cfg="${data_mount}/private/var/db/ConfigurationProfiles/Settings"
	if [ -f "$cfg/.cloudConfigRecordFound" ] || [ -f "$cfg/.cloudConfigHasActivationRecord" ]; then
		echo ""
		warn "Found DEP activation record on $data_mount"
		if [ -t 0 ] && confirm "Auto-wipe DEP record and apply MDM suppression now?"; then
			UNLEASH_CREATE_ADMIN=0
			UNLEASH_VOLUME="$data_mount"
			cmd_apply
			return 0
		fi
	fi

	PS3="Choose: "
	local options=(
		"Auto-wipe DEP & Suppress (Recommended - preserves existing users)"
		"Wipe DEP records only"
		"Full bypass (create admin + suppress MDM)"
		"Suppress enrollment only"
		"Auto-heal"
		"Install pf firewall"
		"Remove pf firewall"
		"Install selective block (iCloud-safe)"
		"Live-OS harden"
		"Deep MDM audit"
		"Backup state"
		"Restore from backup"
		"Check MDM status"
		"Pre-format check"
		"Reboot"
		"Exit"
	)
	select opt in "${options[@]}"; do
		case $opt in
			"Auto-wipe DEP & Suppress (Recommended - preserves existing users)")
				UNLEASH_CREATE_ADMIN=0
				UNLEASH_VOLUME="$data_mount"
				cmd_apply
				;;
			"Wipe DEP records only")
				UNLEASH_CREATE_ADMIN=0
				UNLEASH_VOLUME="$data_mount"
				cmd_apply
				;;
			"Full bypass (create admin + suppress MDM)")
				UNLEASH_CREATE_ADMIN=1
				UNLEASH_VOLUME="$data_mount"
				cmd_apply
				;;
			"Suppress enrollment only")
				UNLEASH_CREATE_ADMIN=0
				UNLEASH_VOLUME="$data_mount"
				cmd_apply
				;;
			"Auto-heal")
				UNLEASH_VOLUME="$data_mount"
				cmd_heal
				;;
			"Install pf firewall")
				install_pf_mdm_block "$data_mount"
				;;
			"Remove pf firewall")
				remove_pf_mdm_block "$data_mount"
				;;
			"Install selective block (iCloud-safe)")
				install_selective_block "$data_mount"
				;;
			"Live-OS harden")
				harden_live_os
				;;
			"Deep MDM audit")
				deep_status
				;;
			"Backup state")
				backup_state "$data_mount"
				;;
			"Restore from backup")
				restore_state
				;;
			"Check MDM status")
				check_mdm_status "$data_mount"
				;;
			"Pre-format check")
				run_preformat_check
				;;
			"Reboot")
				info "Rebooting..."
				reboot
				;;
			"Exit")
				exit 0
				;;
			*)
				echo -e "${RED}Invalid option $REPLY${NC}"
				;;
		esac
	done
}

cmd_interactive_normal() {
	header "unleash"
	echo -e "${YEL}Not in Recovery. Limited options.${NC}"
	echo "  Try: sudo ./unleash heal | harden | audit | check | monitor"
	echo ""

	PS3="Choose: "
	local options=(
		"Auto-heal"
		"Backup state"
		"Restore from backup"
		"Exit"
	)
	select opt in "${options[@]}"; do
		case $opt in
		"Auto-heal")
			if ! is_root; then
				error_exit "Heal needs sudo. Run: sudo ./unleash"
			fi
			cmd_heal
			;;
		"Backup state")
			local data_mount
			data_mount=$(resolve_data_volume)
			is_recovery && DATA_ROOT="$data_mount" || DATA_ROOT=""
			backup_state "$data_mount"
			;;
		"Restore from backup")
			local data_mount
			data_mount=$(resolve_data_volume)
			is_recovery && DATA_ROOT="$data_mount" || DATA_ROOT=""
			restore_state
			;;
		"Exit")
			exit 0
			;;
		*)
			echo -e "${RED}Invalid $REPLY${NC}"
			;;
		esac
	done
}

