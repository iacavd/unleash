export PATH
DISKUTIL=/usr/sbin/diskutil
PLISTBUDDY=/usr/libexec/PlistBuddy
MOUNT=/sbin/mount
PFCTL=/sbin/pfctl
DSCL=/usr/bin/dscl
PLUTIL=/usr/bin/plutil
