#!/bin/bash
set -eEuo pipefail

# Recovery PATH is incomplete; keep system tools first. csrutil/profiles live in /usr/bin on macOS.
PATH="/usr/bin:/bin:/usr/sbin:/sbin${PATH:+:$PATH}"
export PATH
DISKUTIL=/usr/sbin/diskutil
PLISTBUDDY=/usr/libexec/PlistBuddy
MOUNT=/sbin/mount
PFCTL=/sbin/pfctl
DSCL=/usr/bin/dscl
PLUTIL=/usr/bin/plutil
LAUNCHCTL=/bin/launchctl
FDESETUP=/usr/bin/fdesetup
DSCACHEUTIL=/usr/bin/dscacheutil
SHASUM=/usr/bin/shasum
CSRUTIL=/usr/bin/csrutil
PROFILES=/usr/bin/profiles

VERSION="2.0.0"

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
LIB_DIR="$SCRIPT_DIR/lib"

for _lib in colors result config detect validate dscl suppress backup pipeline status heal firewall harden whitelist check monitor history doctor selfupdate uninstall report ma_detect demo vpn init suggest remediate telemetry predict discord automate security webhook simulate tui fleet upgrade web; do
	_lib_path="$LIB_DIR/$_lib.sh"
	if [ -f "$_lib_path" ]; then
		source "$_lib_path"
	else
		echo "ERROR: Library not found: $_lib_path" >&2
		exit 1
	fi
done

# error_exit (lib/colors.sh) stays exit 1 for usage/unhandled abort.
# Process exits are 0, 1, 2, 3, 4 only — matrix in lib/result.sh.
# Do not call log() here: an unwritable LOG_FILE would error_exit inside the trap.
on_err() {
	local line="${1:-?}"
	printf 'level=error module=unleash event=trap msg=unhandled error at line %s\n' "$line" >&2 || true
	pipeline_lock_release || true
	return 0
}
trap 'on_err $LINENO' ERR
trap 'pipeline_lock_release' EXIT

