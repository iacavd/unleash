			error_exit "ERROR E_NOT_ROOT: persist needs root. LaunchDaemons cannot be installed without sudo. Next: sudo ./unleash persist"
		fi
		data_mount=""
		DATA_ROOT=""
	fi
	install_persist_launchdaemon "$data_mount"
}

