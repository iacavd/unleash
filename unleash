cmd_version() {
	echo "unleash v$VERSION"
	exit 0
}

cmd_recovery() {
	header "Recovery Auto-Fix & DEP Eradication"
	local data_mount="${2:-}"
	if [ -z "$data_mount" ]; then
		if is_recovery; then
			data_mount=$(resolve_data_volume)
		else
			warn "System is not booted in macOS Recovery mode."
			warn "System Integrity Protection (SIP) protects .cloudConfigRecordFound from deletion while booted in live macOS."
			if [ -t 0 ] && ! confirm "Continue anyway (e.g. if SIP is disabled or targeting external volume)?"; then
				info "To permanently delete the record from disk, boot into Recovery (Apple Silicon: hold Power; Intel: Cmd+R), open Terminal, and run: ./unleash recovery"
				return 0
			fi
			data_mount=$(resolve_data_volume 2>/dev/null || echo "/")
		fi
	fi
	auto_recovery_mode "$data_mount"
}

cmd_wipe_dep() {
	header "Wipe DEP Records"
	local data_mount="${2:-}"
	if [ -z "$data_mount" ]; then
		if is_recovery; then
			data_mount=$(resolve_data_volume)
		else
			data_mount=$(resolve_data_volume 2>/dev/null || echo "/")
		fi
	fi
	wipe_dep_records "$data_mount"
}

cmd_bypass() {
	if is_recovery; then
		header "Full MDM Bypass"
