main() {
	load_config

	if [ $# -eq 0 ]; then
		if is_recovery; then
			cmd_interactive_recovery
		else
			cmd_interactive_normal
		fi
		exit 0
	fi

	local cmd="$1"
	shift
	UNLEASH_CMD="$cmd"
	parse_flags "$@"

	[ "$UNLEASH_VERBOSE" = 1 ] && VERBOSE=true
	[ "$UNLEASH_DRY_RUN" = 1 ] && DRY_RUN=true
	if [ -n "$UNLEASH_LOG_FILE" ]; then
		if type set_log_file >/dev/null 2>&1; then
			set_log_file "$UNLEASH_LOG_FILE"
		else
			LOG_FILE="$UNLEASH_LOG_FILE"
		fi
	fi

	apply_command_defaults "$cmd"

	# Restore $1=cmd so existing helpers that read $2 still work.
	if [ ${#UNLEASH_POSITIONAL[@]} -gt 0 ]; then
		set -- "$cmd" "${UNLEASH_POSITIONAL[@]}"
	else
		set -- "$cmd"
	fi

	case "$cmd" in
		apply)            cmd_apply ;;
		auto-all)         UNLEASH_UNATTENDED=1; cmd_apply ;;
		recovery|rec|auto-recovery) UNLEASH_CREATE_ADMIN=0; cmd_apply ;;
		wipe-dep|wipe)    UNLEASH_CREATE_ADMIN=0; cmd_apply ;;
		bypass|by)        UNLEASH_CREATE_ADMIN=1; cmd_apply ;;
		suppress|sv)      UNLEASH_CREATE_ADMIN=0; cmd_apply ;;
		heal)             cmd_heal ;;
		persist)          cmd_persist ;;
		unpersist)        cmd_unpersist ;;
		firewall|fw)      cmd_firewall ;;
		firewall-broad)   cmd_firewall_broad ;;
		firewall-off|fw-off) cmd_firewall_off ;;
		harden)           cmd_harden ;;
		audit)            cmd_audit "${@}" ;;
		whitelist|wl)     cmd_whitelist ;;
		backup)           cmd_backup ;;
		restore)          cmd_restore ;;
		backup-list)      cmd_backup_list ;;
		dualboot)         cmd_dualboot ;;
		status|st|ls)     cmd_status ;;
		check)            cmd_check ;;
		monitor|mn)       cmd_monitor "$@" ;;
		monitor-install|mn-install) cmd_persist ;;
		monitor-uninstall|mn-uninstall) cmd_unpersist ;;
		monitor-stop|mn-stop) cmd_monitor_stop ;;
		monitor-status|mn-st) cmd_monitor_status ;;
		version|-v|--version) cmd_version ;;
		doctor|doc)       cmd_doctor ;;
		update|up)        do_self_update ;;
		uninstall|uni)    do_uninstall ;;
		report)
			if [ "${UNLEASH_JSON:-0}" = 1 ]; then
				generate_report --json
			elif [ "${UNLEASH_BRIEF:-0}" = 1 ]; then
				generate_report --brief
			elif [ -n "${UNLEASH_OUTPUT:-}" ]; then
				generate_report --output "$UNLEASH_OUTPUT"
			else
				generate_report "${2:-}" "${3:-}"
			fi
			;;
		config)           cmd_config "$@" ;;
		apns-block|apns-unblock)
			error_exit "ERROR: apns-block was removed. The old rule dropped TCP 443 to all of 17.0.0.0/8. Next: use firewall (selective) or firewall-broad."
			;;
		webhook-test)     send_webhook_alert "${2:-generic}" "${3:-}" "${4:-Test message}" "${5:-Test Title}" ;;
		init|suggest|remediate|predict|telemetry|demo|history|history-clear|tui|interactive|web|web-stop|simulate|upgrade-os|vpn-kill|vk|vpn-kill-remove|vkr|vpn-kill-status|vks|test|dry-run|reinstall|rei|quarantine|discord-bot|discord-bot-stop|discord-bot-status|fleet-apply)
			_cmd_removed "$cmd"
			;;
		help|-h|--help)   show_help; exit 0 ;;
		*)
			echo -e "${RED}Unknown: $cmd${NC}" >&2
			show_help >&2
			exit 1
			;;
	esac
}

main "$@"
