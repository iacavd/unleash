# $1=flag $2=argc $3=next token (may be unset). Do not read $2 in the caller first.
require_flag_value() {
	if [ "$2" -lt 2 ]; then
		echo "Missing value for $1" >&2
		exit 1
	fi
	case "${3-}" in
		--*)
			echo "Missing value for $1" >&2
			exit 1
			;;
	esac
}

# Mutates UNLEASH_* from flags after the command. Leftovers → UNLEASH_POSITIONAL.
parse_flags() {
	UNLEASH_POSITIONAL=()
	while [ $# -gt 0 ]; do
		case "$1" in
			--unattended) UNLEASH_UNATTENDED=1; shift ;;
			--dry-run)    UNLEASH_DRY_RUN=1; shift ;;
			--yes)        UNLEASH_YES=1; shift ;;
			--json)       UNLEASH_JSON=1; shift ;;
			--verbose)    UNLEASH_VERBOSE=1; shift ;;
			--brief)      UNLEASH_BRIEF=1; shift ;;
			--log-file)
				require_flag_value "$1" $# "${2-}"
				UNLEASH_LOG_FILE="$2"
				shift 2
				;;
			--volume)
				require_flag_value "$1" $# "${2-}"
				UNLEASH_VOLUME="$2"
				shift 2
				;;
			--username)
				require_flag_value "$1" $# "${2-}"
				UNLEASH_USERNAME="$2"
				shift 2
				;;
			--password)
				require_flag_value "$1" $# "${2-}"
				UNLEASH_PASSWORD="$2"
				shift 2
				;;
			--password-file)
				require_flag_value "$1" $# "${2-}"
				UNLEASH_PASSWORD_FILE="$2"
				shift 2
				;;
			--fv-password-file)
				require_flag_value "$1" $# "${2-}"
				UNLEASH_FV_PASSWORD_FILE="$2"
				shift 2
				;;
			--fv-recovery-key-file)
				require_flag_value "$1" $# "${2-}"
				UNLEASH_FV_KEY_FILE="$2"
				shift 2
				;;
			--firewall-mode)
				require_flag_value "$1" $# "${2-}"
				UNLEASH_FIREWALL_MODE="$2"
				shift 2
				;;
			--firewall-mode=*)
				UNLEASH_FIREWALL_MODE="${1#--firewall-mode=}"
				shift
				;;
			--snapshot)
				require_flag_value "$1" $# "${2-}"
				UNLEASH_SNAPSHOT="$2"
				shift 2
				;;
			--realname)
				require_flag_value "$1" $# "${2-}"
				UNLEASH_REALNAME="$2"
				shift 2
				;;
			--webhook)
				require_flag_value "$1" $# "${2-}"
				UNLEASH_WEBHOOK="$2"
				shift 2
				;;
			--manifest)
				require_flag_value "$1" $# "${2-}"
				UNLEASH_MANIFEST="$2"
				shift 2
				;;
			--output)
				require_flag_value "$1" $# "${2-}"
				UNLEASH_OUTPUT="$2"
				shift 2
				;;
			--port)
				require_flag_value "$1" $# "${2-}"
				UNLEASH_PORT="$2"
				shift 2
				;;
			--interface)
				require_flag_value "$1" $# "${2-}"
				UNLEASH_INTERFACE="$2"
				shift 2
				;;
			--allow-weak-password) UNLEASH_ALLOW_WEAK=1; shift ;;
			--create-admin) UNLEASH_CREATE_ADMIN=1; shift ;;
			--harden)     UNLEASH_HARDEN=1; shift ;;
			--remove-all-profiles) UNLEASH_REMOVE_ALL_PROFILES=1; shift ;;
			--i-own-this-device) UNLEASH_INTENT_FLAG=1; shift ;;
			--gate)       UNLEASH_GATE=1; shift ;;
			--help|-h)
				show_cmd_help "${UNLEASH_CMD:-}"
				exit 0
				;;
			--*)
				echo "Unknown flag: $1" >&2
				exit 1
				;;
			*)
				break
				;;
		esac
	done
	UNLEASH_POSITIONAL=("$@")
}

# auto-all is unattended even without --unattended.
apply_command_defaults() {
	case "$1" in
		auto-all) UNLEASH_UNATTENDED=1 ;;
		bypass|by) UNLEASH_CREATE_ADMIN=1 ;;
		recovery|rec|auto-recovery|suppress|sv|wipe-dep|wipe) UNLEASH_CREATE_ADMIN=0 ;;
	esac
}
