UNLEASH_CMD=""
UNLEASH_POSITIONAL=()

# $1=flag $2=argc $3=next token (may be unset). Do not read $2 in the caller first.
require_flag_value() {
	if [ "$2" -lt 2 ]; then
		echo "Missing value for $1" >&2
		exit 1
	fi
	case "${3-}" in
		--*)
			echo "Missing value for $1" >&2
			exit 1
			;;
	esac
}

# Mutates UNLEASH_* from flags after the command. Leftovers → UNLEASH_POSITIONAL.
parse_flags() {
	UNLEASH_POSITIONAL=()
	while [ $# -gt 0 ]; do
		case "$1" in
			--unattended) UNLEASH_UNATTENDED=1; shift ;;
			--dry-run)    UNLEASH_DRY_RUN=1; shift ;;
			--yes)        UNLEASH_YES=1; shift ;;
			--json)       UNLEASH_JSON=1; shift ;;
			--verbose)    UNLEASH_VERBOSE=1; shift ;;
			--brief)      UNLEASH_BRIEF=1; shift ;;
			--log-file)
				require_flag_value "$1" $# "${2-}"
				UNLEASH_LOG_FILE="$2"
				shift 2
				;;
			--volume)
				require_flag_value "$1" $# "${2-}"
				UNLEASH_VOLUME="$2"
				shift 2
				;;
			--username)
				require_flag_value "$1" $# "${2-}"
				UNLEASH_USERNAME="$2"
				shift 2
				;;
			--password)
				require_flag_value "$1" $# "${2-}"
				UNLEASH_PASSWORD="$2"
				shift 2
				;;
			--password-file)
				require_flag_value "$1" $# "${2-}"
				UNLEASH_PASSWORD_FILE="$2"
				shift 2
				;;
			--fv-password-file)
				require_flag_value "$1" $# "${2-}"
				UNLEASH_FV_PASSWORD_FILE="$2"
				shift 2
				;;
			--fv-recovery-key-file)
				require_flag_value "$1" $# "${2-}"
				UNLEASH_FV_KEY_FILE="$2"
				shift 2
				;;
			--firewall-mode)
				require_flag_value "$1" $# "${2-}"
				UNLEASH_FIREWALL_MODE="$2"
				shift 2
				;;
			--firewall-mode=*)
				UNLEASH_FIREWALL_MODE="${1#--firewall-mode=}"
				shift
				;;
			--snapshot)
				require_flag_value "$1" $# "${2-}"
				UNLEASH_SNAPSHOT="$2"
				shift 2
				;;
			--realname)
				require_flag_value "$1" $# "${2-}"
				UNLEASH_REALNAME="$2"
				shift 2
				;;
			--webhook)
				require_flag_value "$1" $# "${2-}"
				UNLEASH_WEBHOOK="$2"
				shift 2
				;;
			--manifest)
				require_flag_value "$1" $# "${2-}"
				UNLEASH_MANIFEST="$2"
				shift 2
				;;
			--output)
				require_flag_value "$1" $# "${2-}"
				UNLEASH_OUTPUT="$2"
				shift 2
				;;
			--port)
				require_flag_value "$1" $# "${2-}"
				UNLEASH_PORT="$2"
				shift 2
				;;
			--interface)
				require_flag_value "$1" $# "${2-}"
				UNLEASH_INTERFACE="$2"
				shift 2
				;;
			--allow-weak-password) UNLEASH_ALLOW_WEAK=1; shift ;;
			--create-admin) UNLEASH_CREATE_ADMIN=1; shift ;;
			--harden)     UNLEASH_HARDEN=1; shift ;;
			--i-own-this-device) UNLEASH_INTENT_FLAG=1; shift ;;
			--help|-h)
				show_cmd_help "${UNLEASH_CMD:-}"
				exit 0
				;;
			--*)
				echo "Unknown flag: $1" >&2
				exit 1
				;;
			*)
				break
				;;
		esac
	done
	UNLEASH_POSITIONAL=("$@")
}

# auto-all is unattended even without --unattended.
apply_command_defaults() {
	case "$1" in
		auto-all) UNLEASH_UNATTENDED=1 ;;
	esac
}
# --- end CLI parse ---

main() {
	load_config

	if [ $# -eq 0 ]; then
		if is_recovery; then
			cmd_interactive_recovery
		else
			cmd_interactive_normal
		fi
		exit 0
	fi

	local cmd="$1"
	shift
	UNLEASH_CMD="$cmd"
	parse_flags "$@"

	[ "$UNLEASH_VERBOSE" = 1 ] && VERBOSE=true
	[ "$UNLEASH_DRY_RUN" = 1 ] && DRY_RUN=true
	if [ -n "$UNLEASH_LOG_FILE" ]; then
		if type set_log_file >/dev/null 2>&1; then
			set_log_file "$UNLEASH_LOG_FILE"
		else
			LOG_FILE="$UNLEASH_LOG_FILE"
		fi
	fi

	apply_command_defaults "$cmd"

	# Restore $1=cmd so existing helpers that read $2 still work.
	if [ ${#UNLEASH_POSITIONAL[@]} -gt 0 ]; then
		set -- "$cmd" "${UNLEASH_POSITIONAL[@]}"
	else
		set -- "$cmd"
	fi

	case "$cmd" in
		apply)            cmd_apply "$@" ;;
		auto-all)         cmd_apply "$@" ;;
		recovery|rec|auto-recovery) cmd_recovery "${@}" ;;
		wipe-dep|wipe)    cmd_wipe_dep "${@}" ;;
		bypass|by)        cmd_bypass ;;
		suppress|sv)      cmd_suppress ;;
		heal)             cmd_heal ;;
		persist)          cmd_persist ;;
		unpersist)        cmd_unpersist ;;
		firewall|fw)      cmd_firewall ;;
		firewall-broad)   cmd_firewall_broad ;;
		firewall-off|fw-off) cmd_firewall_off ;;
		harden)           cmd_harden ;;
		audit)            cmd_audit "${@}" ;;
		whitelist|wl)     cmd_whitelist ;;
		backup)           cmd_backup ;;
		restore)          cmd_restore ;;
		backup-list)      cmd_backup_list ;;
		dualboot)         cmd_dualboot ;;
		status|st|ls)     cmd_status ;;
		check)            cmd_check ;;
		history)          cmd_history ;;
		history-clear)    cmd_history_clear ;;
		test|dry-run)     cmd_test "$@" ;;
		monitor|mn)       cmd_monitor "$@" ;;
		monitor-install|mn-install) cmd_persist ;;
		monitor-uninstall|mn-uninstall) cmd_unpersist ;;
		monitor-stop|mn-stop) cmd_monitor_stop ;;
		monitor-status|mn-st) cmd_monitor_status ;;
		version|-v|--version) cmd_version ;;
		doctor|doc)       cmd_doctor ;;
		init)             cmd_init ;;
		suggest)          cmd_suggest ;;
		remediate)        cmd_remediate "${2:-}" ;;
		predict)          cmd_predict "${2:-}" ;;
		telemetry)        telemetry_opt_in "${2:-}" ;;
		demo)             run_demo ;;
		update|up)        do_self_update ;;
		uninstall|uni)    do_uninstall ;;
		report)
			if [ "${UNLEASH_JSON:-0}" = 1 ]; then
				generate_report --json
			elif [ "${UNLEASH_BRIEF:-0}" = 1 ]; then
				generate_report --brief
			elif [ -n "${UNLEASH_OUTPUT:-}" ]; then
				generate_report --output "$UNLEASH_OUTPUT"
			else
				generate_report "${2:-}" "${3:-}"
			fi
			;;
		config)           cmd_config "$@" ;;
		vpn-kill|vk)      vpn_kill_install "$@" ;;
		vpn-kill-remove|vkr) vpn_kill_remove ;;
		vpn-kill-status|vks) vpn_kill_status ;;
		apns-block|apns-unblock)
			error_exit "ERROR: apns-block was removed. The old rule dropped TCP 443 to all of 17.0.0.0/8. Next: use firewall (selective) or firewall-broad."
			;;
		quarantine)       quarantine_profiles "${2:-/}" ;;
		webhook-test)     send_webhook_alert "${2:-generic}" "${3:-}" "${4:-Test message}" "${5:-Test Title}" ;;
		simulate)         run_simulation "${2:-/}" ;;
		tui|interactive)  launch_tui ;;
		fleet-apply)      cmd_fleet_apply "$@" ;;
		upgrade-os)       cmd_upgrade_os ;;
		web)
			if [ -n "${UNLEASH_PORT:-}" ]; then
				cmd_web_server "$UNLEASH_PORT"
			else
				cmd_web_server "${2:-8080}"
			fi
			;;
		web-stop)         cmd_web_stop ;;
		reinstall|rei)
			do_uninstall
			cmd_persist
			cmd_firewall
			success "Reinstall complete"
			;;
		discord-bot)      cmd_discord_bot_install "${2:-}" "${3:-}" ;;
		discord-bot-stop) cmd_discord_bot_stop ;;
		discord-bot-status) cmd_discord_bot_status ;;
		help|-h|--help)   show_help; exit 0 ;;
		*)
			echo -e "${RED}Unknown: $cmd${NC}" >&2
			show_help >&2
			exit 1
			;;
	esac
}

main "$@"
