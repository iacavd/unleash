SHASUM=/usr/bin/shasum
CSRUTIL=/usr/bin/csrutil
PROFILES=/usr/bin/profiles

VERSION="2.1.0"

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
LIB_DIR="$SCRIPT_DIR/lib"

# Recovery/core + thin aliases + later (update/report/webhook). Overlay lives in graveyard/.
for _lib in colors result config detect validate dscl suppress backup pipeline status heal firewall harden whitelist check monitor doctor selfupdate uninstall report ma_detect automate webhook; do
	_lib_path="$LIB_DIR/$_lib.sh"
	if [ -f "$_lib_path" ]; then
		source "$_lib_path"
	else
		echo "ERROR: Library not found: $_lib_path" >&2
		exit 1
	fi
done

_cmd_removed() {
	echo "ERROR: $1 was removed in Unleash 2.1. Overlay commands are not part of the autonomy core. Next: ./unleash help" >&2
	exit 1
}

# error_exit (lib/colors.sh) stays exit 1 for usage/unhandled abort.
# Process exits are 0, 1, 2, 3, 4 only — matrix in lib/result.sh.
# Do not call log() here: an unwritable LOG_FILE would error_exit inside the trap.
on_err() {
	local line="${1:-?}"
	printf 'level=error module=unleash event=trap msg=unhandled error at line %s\n' "$line" >&2 || true
	if [ -n "${JOURNAL_RUN:-}" ]; then
		journal_abort || true
	fi
	pipeline_lock_release || true
	return 0
}
trap 'on_err $LINENO' ERR
trap 'pipeline_lock_release' EXIT

